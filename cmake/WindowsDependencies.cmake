# vcpkg x64-windows provides shared codecs, copied beside the application.
find_package(JPEG REQUIRED)
find_package(PNG REQUIRED)
find_package(TIFF 4.6.1 REQUIRED)
find_package(ZLIB REQUIRED)
find_package(Freetype REQUIRED)
function(pe_windows_library target header library)
  find_path(${library}_INCLUDE_DIR NAMES ${header} REQUIRED)
  find_library(${library}_LIBRARY NAMES ${library} lib${library} REQUIRED)
  add_library(${target} UNKNOWN IMPORTED GLOBAL)
  set_target_properties(${target} PROPERTIES
    IMPORTED_LOCATION "${${library}_LIBRARY}"
    INTERFACE_INCLUDE_DIRECTORIES "${${library}_INCLUDE_DIR}")
endfunction()
pe_windows_library(PkgConfig::LCMS2 lcms2.h lcms2)
if(PE_WITH_HEIF)
  pe_windows_library(PkgConfig::HEIF libheif/heif.h heif)
  set(HEIF_FOUND TRUE)
endif()
if(PE_WITH_WEBP)
  pe_windows_library(PkgConfig::WEBP webp/decode.h webp)
  pe_windows_library(PkgConfig::WEBPDEMUX webp/demux.h webpdemux)
  set(WEBP_FOUND TRUE)
  set(WEBPDEMUX_FOUND TRUE)
endif()
